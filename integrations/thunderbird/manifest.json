{
  "manifest_version": 2,
  "name": "CalDAV Assistant",
  "version": "0.1.0",
  "description": "Thunderbird workspace for CalDAV Assistant work sessions and WordPress logs.",
  "applications": {
    "gecko": {
      "id": "caldav-assistant@zhouandrew.local",
      "strict_min_version": "115.0"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": [
    "nativeMessaging",
    "storage"
  ]
}
