{
  "manifest_version": 2,
  "name": "CalDAV Assistant",
  "description": "Native Thunderbird task work controls and verified durable WordPress logging.",
  "version": "0.4.3",
  "author": "ZhouAndrew",
  "background": {
    "scripts": [
      "core/action-plan.js",
      "core/storage.js",
      "core/wordpress.js",
      "core/daily-log.js",
      "core/executor.js",
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ZhouAndrew.thunderbird-taskfix-lab@addons.thunderbird.net",
      "strict_min_version": "153.0.2",
      "strict_max_version": "153.1.*"
    }
  },
  "experiment_apis": {
    "PostPreview": {
      "schema": "api/PostPreview/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["PostPreview"]],
        "script": "api/PostPreview/implementation.js"
      }
    },
    "TaskFix": {
      "schema": "api/TaskFix/schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "TaskFix"
          ]
        ],
        "script": "api/TaskFix/implementation.js",
        "events": [
          "startup"
        ]
      }
    },
    "ThunderbirdCalDAV": {
      "schema": "api/ThunderbirdCalDAV/schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "ThunderbirdCalDAV"
          ]
        ],
        "script": "api/ThunderbirdCalDAV/implementation.js"
      }
    }
  },
  "permissions": [
    "storage"
  ]
}
