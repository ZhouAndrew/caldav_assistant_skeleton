{
  "manifest_version": 2,
  "name": "CalDAV Assistant · Functional Rebuild",
  "version": "0.4.0",
  "description": "Independent clean-room candidate; real acceptance required before release.",
  "browser_specific_settings": {
    "gecko": {
      "id": "ZhouAndrew.thunderbird-taskfix-lab@addons.thunderbird.net",
      "strict_min_version": "140.0"
    }
  },
  "permissions": [
    "storage",
    "tabs",
    "<all_urls>",
    "alarms"
  ],
  "background": {
    "page": "background.html"
  },
  "experiment_apis": {
    "assistantNative": {
      "schema": "api/schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "assistantNative"
          ]
        ],
        "script": "api/implementation.js"
      }
    }
  }
}
