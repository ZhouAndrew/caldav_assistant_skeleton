{
  "manifest_version": 2,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "version": "0.4.0",
  "author": "ZhouAndrew",
  "background": {
    "scripts": [
      "generated/core.js",
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ZhouAndrew.thunderbird-taskfix-lab@addons.thunderbird.net",
      "strict_min_version": "153.0.2",
      "strict_max_version": "153.1.*"
    }
  },
  "experiment_apis": {
    "NativeTasks": {
      "schema": "api/NativeTasks/schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "NativeTasks"
          ]
        ],
        "script": "api/NativeTasks/implementation.js"
      }
    }
  },
  "permissions": [
    "storage"
  ],
  "default_locale": "en"
}
